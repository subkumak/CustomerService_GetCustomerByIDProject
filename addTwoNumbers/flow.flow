interface default

service addTwoNumbers (
    input {
        String num1;
        String num2;
    }
    output {
        String sum;
    }
)
{
    INVOKE pub.math:addInts {
        input {
            mapSource {
                String num1;
                String num2;
            }
            mapTarget {
                String num1;
                String num2;
            }
            copy num1 -> num1;
            copy num2 -> num2;
        }
        output {
            mapSource {
                String `value`;
            }
            mapTarget {
                String sum;
            }
            copy `value` -> sum;
        }
    }
}
