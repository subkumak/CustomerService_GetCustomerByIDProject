interface CustomerService

service customerService_GetCustomerByID (
    input {
        String customer_id;
    }
    output {
        String name;
        String email;
        String accountStatus;
        String errorMessage;
    }
)
{
    MAP {
        mapTarget {
            String fullUrl;
        }
        set (variable) fullUrl = "http://localhost:5001/customers/%customer_id%";
    }
    TRY {
        INVOKE pub.client:http {
            input {
                mapSource {
                    String fullUrl;
                }
                mapTarget {
                    String url;
                    String method;
                }
                copy fullUrl -> url;
                set method = "get";
            }
        }
        MAP {
            mapSource {
                record header {
                    String status;
                };
            }
            mapTarget {
                String httpStatus;
            }
            copy header/status -> httpStatus;
        }
        INVOKE pub.string:bytesToString {
            input {
                mapSource {
                    record body {
                        Object bytes;
                    };
                }
                mapTarget {
                    Object bytes;
                    String encoding;
                }
                copy body/bytes -> bytes;
                set encoding = "UTF-8";
            }
            output {
                mapSource {
                    String string;
                }
                mapTarget {
                    String responseString;
                }
                copy string -> responseString;
            }
        }
        INVOKE pub.json:jsonStringToDocument {
            input {
                mapSource {
                    String responseString;
                }
                mapTarget {
                    String jsonString;
                }
                copy responseString -> jsonString;
            }
            output {
                mapSource {
                    record `document` {
                    };
                }
                mapTarget {
                    record customerDoc {
                    };
                }
                copy `document` -> customerDoc;
            }
        }
        IF (%httpStatus% == "200") {
            INVOKE pub.string:concat {
                input {
                    mapSource {
                        record customerDoc {
                        };
                    }
                    mapTarget {
                        String inString1;
                        String inString2;
                    }
                    set (variable) inString1 = "%customerDoc/first_name%";
                    set inString2 = " ";
                }
                output {
                    mapSource {
                        String `value`;
                    }
                    mapTarget {
                        String namePart1;
                    }
                    copy `value` -> namePart1;
                }
            }
            INVOKE pub.string:concat {
                input {
                    mapSource {
                        String namePart1;
                        record customerDoc {
                        };
                    }
                    mapTarget {
                        String inString1;
                        String inString2;
                    }
                    copy namePart1 -> inString1;
                    set (variable) inString2 = "%customerDoc/last_name%";
                }
                output {
                    mapSource {
                        String `value`;
                    }
                    mapTarget {
                        String name;
                    }
                    copy `value` -> name;
                }
            }
            MAP {
                mapTarget {
                    String email;
                    String accountStatus;
                    String errorMessage;
                }
                set (variable) email = "%customerDoc/email%";
                set (variable) accountStatus = "%customerDoc/status%";
                set errorMessage = "";
            }
        }
        ELSEIF (%httpStatus% == "404") {
            MAP {
                mapTarget {
                    String errorMessage;
                    String name;
                    String email;
                    String accountStatus;
                }
                set errorMessage = "Customer not found";
                set name = "";
                set email = "";
                set accountStatus = "";
            }
        }
        ELSE {
            MAP {
                mapTarget {
                    String errorMessage;
                    String name;
                    String email;
                    String accountStatus;
                }
                set errorMessage = "Customer API unavailable";
                set name = "";
                set email = "";
                set accountStatus = "";
            }
        }
    }
    CATCH {
        MAP {
            mapTarget {
                String errorMessage;
                String name;
                String email;
                String accountStatus;
            }
            set errorMessage = "Customer API unavailable";
            set name = "";
            set email = "";
            set accountStatus = "";
        }
    }
}
