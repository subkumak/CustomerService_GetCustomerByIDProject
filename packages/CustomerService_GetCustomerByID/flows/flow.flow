interface CustomerService_GetCustomerByID

service GetCustomerByID (
    input {
        String customerId;
        String requestType;
    }
    output {
        record customerData {
        };
        String status;
        String errorMessage;
    }
)
{
    INVOKE pub.string:concat {
        input {
            mapSource {
                String customerId;
            }
            mapTarget {
                String inString1;
                String inString2;
            }
            set inString1 = "http://localhost:5001/customers/";
            copy customerId -> inString2;
        }
        output {
            mapSource {
                String `value`;
            }
            mapTarget {
                String fullUrl;
            }
            copy `value` -> fullUrl;
        }
    }
    TRY {
        INVOKE pub.client:http {
            input {
                mapSource {
                    String fullUrl;
                }
                mapTarget {
                    String url;
                    String method;
                }
                copy fullUrl -> url;
                set method = "get";
            }
        }
        MAP {
            mapSource {
                record header {
                    String status;
                };
            }
            mapTarget {
                String httpStatus;
            }
            copy header/status -> httpStatus;
        }
        INVOKE pub.string:bytesToString {
            input {
                mapSource {
                    record body {
                        Object bytes;
                    };
                }
                mapTarget {
                    Object bytes;
                    String encoding;
                }
                copy body/bytes -> bytes;
                set encoding = "UTF-8";
            }
            output {
                mapSource {
                    String string;
                }
                mapTarget {
                    String responseString;
                }
                copy string -> responseString;
            }
        }
        IF (%httpStatus% == "200") {
            INVOKE pub.json:jsonStringToDocument {
                input {
                    mapSource {
                        String responseString;
                    }
                    mapTarget {
                        String jsonString;
                    }
                    copy responseString -> jsonString;
                }
                output {
                    mapSource {
                        record `document` {
                        };
                    }
                    mapTarget {
                        record customerData {
                        };
                    }
                    copy `document` -> customerData;
                }
            }
            MAP {
                mapTarget {
                    String status;
                    String errorMessage;
                }
                set status = "SUCCESS";
                set errorMessage = "";
            }
        }
        ELSEIF (%httpStatus% == "404") {
            MAP {
                mapTarget {
                    String status;
                    String errorMessage;
                }
                set status = "NOT_FOUND";
                set errorMessage = "Customer not found";
            }
        }
        ELSE {
            MAP {
                mapTarget {
                    String status;
                    String errorMessage;
                }
                set status = "ERROR";
                set errorMessage = "Customer API unavailable";
            }
        }
    }
    CATCH {
        INVOKE pub.flow:getLastError {
            output {
                mapSource {
                    record lastError {
                        String message;
                    };
                }
                mapTarget {
                    String lastErrorMessage;
                }
                copy lastError/message -> lastErrorMessage;
            }
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String lastErrorMessage;
                }
                mapTarget {
                    String message;
                }
                copy lastErrorMessage -> message;
            }
        }
        MAP {
            mapTarget {
                String status;
                String errorMessage;
            }
            set status = "ERROR";
            set errorMessage = "Customer API unavailable";
        }
    }
}
